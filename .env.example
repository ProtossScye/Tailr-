# Variable names only. Real values go in .env.local, which git ignores.

# Safe to expose: the project URL and the publishable key (row-level security protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://lyikzuysmzalkhubtcut.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Bypasses all row-level security. Never use in browser code,
# never commit, never paste into chat.
SUPABASE_SECRET_KEY=

# AI slip reading (server-side only). Leave ANTHROPIC_API_KEY empty and the feature stays off.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
TAILR_AI_MODEL=
# Optional. Milliseconds to wait for the AI, 1000 to 120000. Defaults to 20000.
TAILR_AI_TIMEOUT_MS=

# Telegram (server-side only). Leave these empty and Telegram stays off.
# Create the bot with @BotFather to get the token and the username.
TELEGRAM_BOT_TOKEN=
# Any long random string of letters, digits, - and _ (24 to 256 characters). Telegram sends it back on every call.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# The web address of the live site, for example https://your-app.vercel.app
TAILR_APP_URL=
# Private beta (optional). Set a code to make sign-up invite-only; leave empty to keep sign-up open.
TAILR_BETA_CODE=
