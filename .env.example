# Variable names only. Real values go in .env.local, which git ignores.

# Safe to expose: the project URL and the publishable key (row-level security protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://lyikzuysmzalkhubtcut.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Bypasses all row-level security. Never use in browser code,
# never commit, never paste into chat.
SUPABASE_SECRET_KEY=

# AI slip reading (server-side only). Leave ANTHROPIC_API_KEY empty and the feature stays off.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
TAILR_AI_MODEL=
# Optional. Milliseconds to wait for the AI, 1000 to 120000. Defaults to 20000.
TAILR_AI_TIMEOUT_MS=
